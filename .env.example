GEMINI_API_KEY=your_gemini_api_key
PEXELS_API_KEY=your_pexels_api_key

# Optional: override the Gemini model used by modules/brain.py (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: YouTube auto-upload (run authorize_youtube.py once to mint these)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
